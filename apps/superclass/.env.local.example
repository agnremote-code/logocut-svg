# Superclass-only server configuration. Do not copy LogoCut variables here.
SUPERCLASS_LESSON_PROVIDER=local
SUPERCLASS_OPENAI_API_KEY=
SUPERCLASS_OPENAI_MODEL=gpt-5.4-mini
SUPERCLASS_PROVIDER_TIMEOUT_MS=45000
SUPERCLASS_MAX_SOURCE_CHARS=12000
SUPERCLASS_GENERATION_CACHE=memory

# Existing client-side preview option (not a secret).
NEXT_PUBLIC_SUPERCLASS_UNLOCKED=false
